<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp">

    <TextView
        style="@style/Fly.Hero"
        android:text="@string/widgets_title" />

    <TextView
        style="@style/Fly.Body"
        android:layout_marginTop="6dp"
        android:text="@string/widgets_subtitle" />

    <TextView
        android:id="@+id/txtWidgetSupport"
        style="@style/Fly.Caption"
        android:layout_marginTop="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/widgetList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/txtWidgetsEmpty"
        style="@style/Fly.Body"
        android:text="@string/widgets_empty"
        android:visibility="gone" />

</LinearLayout>
