<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp">

    <TextView
        style="@style/Fly.Hero"
        android:text="@string/icons_title" />

    <TextView
        style="@style/Fly.Body"
        android:layout_marginTop="6dp"
        android:text="@string/icons_subtitle" />

    <TextView
        style="@style/Fly.Section"
        android:layout_marginTop="14dp"
        android:text="@string/fly_packs_label" />

    <TextView
        style="@style/Fly.Caption"
        android:text="@string/fly_packs_hint" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/flyPackList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <TextView
        style="@style/Fly.Section"
        android:layout_marginTop="14dp"
        android:text="@string/packs_label" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/packList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/txtPacksEmpty"
        style="@style/Fly.Body"
        android:text="@string/packs_empty"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtSelectedPack"
        style="@style/Fly.Title"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/txtCoverage"
        style="@style/Fly.Caption"
        android:layout_marginTop="2dp" />

    <TextView
        style="@style/Fly.Caption"
        android:layout_marginTop="6dp"
        android:text="@string/pin_hint" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/search_apps_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/iconProgress"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtSearchEmpty"
        style="@style/Fly.Body"
        android:layout_marginTop="8dp"
        android:text="@string/search_empty"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appIconList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
