<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Fly.Hero"
            android:text="@string/settings_title" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Fly.Card"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Fly.Section"
                    android:text="@string/settings_wallpaper" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/settingsTargetGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTargetBothSettings"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/target_both" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTargetHomeSettings"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/target_home" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTargetLockSettings"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/target_lock" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenThemes"
                    style="@style/Fly.OutlinedButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_open_themes" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Fly.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Fly.Section"
                    android:text="@string/settings_updates" />

                <TextView
                    android:id="@+id/txtUpdateStatus"
                    style="@style/Fly.Body" />

                <TextView
                    android:id="@+id/txtCurrentBuild"
                    style="@style/Fly.Caption"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/progressUpdate"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="?attr/colorPrimary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckUpdates"
                        style="@style/Fly.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/update_check_button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenRelease"
                        style="@style/Fly.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/update_open_releases" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Fly.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Fly.Section"
                    android:text="@string/settings_data" />

                <TextView
                    android:id="@+id/txtDataSummary"
                    style="@style/Fly.Body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        style="@style/Fly.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_history" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearFavorites"
                        style="@style/Fly.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/btn_clear_favorites" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Fly.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/Fly.Section"
                    android:text="@string/settings_about" />

                <TextView
                    android:id="@+id/txtVersion"
                    style="@style/Fly.Row" />

                <TextView
                    android:id="@+id/txtNativeVersion"
                    style="@style/Fly.Row" />

                <TextView
                    style="@style/Fly.Body"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
