<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp">

    <TextView
        style="@style/Fly.Hero"
        android:text="@string/wallpapers_title" />

    <TextView
        style="@style/Fly.Body"
        android:layout_marginTop="6dp"
        android:text="@string/wallpapers_subtitle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemix"
            style="@style/Fly.OutlinedButton"
            android:text="@string/btn_remix" />

        <TextView
            android:id="@+id/txtHueShift"
            style="@style/Fly.Caption"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1" />

        <ProgressBar
            android:id="@+id/applyProgress"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        style="@style/Fly.Section"
        android:layout_marginTop="16dp"
        android:text="@string/apply_target_label" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/targetGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTargetBoth"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_both" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTargetHome"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_home" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTargetLock"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_lock" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wallpaperGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

</LinearLayout>
