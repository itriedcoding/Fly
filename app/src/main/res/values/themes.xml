<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Fly.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/fly_brand</item>
        <item name="colorSecondary">@color/fly_brand</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="materialCardViewStyle">@style/Widget.Material3.CardView.Filled</item>
    </style>

    <style name="Theme.Fly.Light" parent="Theme.Fly.Base">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceContainer">@color/surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>
        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>
        <item name="android:colorBackground">@color/surface_light</item>
        <item name="colorOnBackground">@color/on_surface_light</item>
    </style>

    <style name="Theme.Fly.Dark" parent="Theme.Fly.Base">
        <item name="colorSurface">@color/surface_dark</item>
